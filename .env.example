# Public base URL for the frontend (SvelteKit build-time).
# - Leave empty to use the current origin (recommended when frontend+backend are served together).
# - Set to your external domain if you need absolute URLs in the client bundle.
PUBLIC_API_BASE_URL=''

# Canonical external URL (used by backend for OAuth redirects, share links, opensearch, etc.)
WEBUI_URL='https://aia.crypt.ge'

# CORS (only relevant for cross-origin setups; keep aligned with your domain).
CORS_ALLOW_ORIGIN='https://aia.crypt.ge'

# Cookie security (recommended for HTTPS deployments).
WEBUI_SESSION_COOKIE_SECURE=true
WEBUI_AUTH_COOKIE_SECURE=true

# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://ollama:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like:
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# PY Photo (text-to-image via Pillow)
# Optional: Path to a .ttf/.otf/.ttc font file (or directory) for better Unicode coverage (e.g., Georgian).
# PY_PHOTO_FONT_PATH=
# Tip (Docker/Linux): mount emoji + Georgian fonts and point `PY_PHOTO_FONT_PATH` to the mounted directory.

# PDF Generator (chat-to-PDF)
# Enable / disable the PDF Generator integration (also controllable via Admin Settings).
# ENABLE_PDF_GENERATOR=true
# Optional: Path to a Georgian-capable Unicode font file or directory (e.g. NotoSansGeorgian-Regular.ttf, DejaVuSans.ttf, Sylfaen.ttf).
# PDF_FONT_PATH=

# ElevenLabs Music (free, no credits)
# ELEVENLABS_API_KEY=
# ELEVENLABS_MUSIC_ENABLED=true
# ELEVENLABS_MUSIC_MODE=detailed
# ELEVENLABS_MUSIC_DEFAULT_FORMAT=mp3_44100_128
# ELEVENLABS_MUSIC_MODEL_ID=music_v1
# ELEVENLABS_MUSIC_DEFAULT_LENGTH_MS=30000
# ELEVENLABS_MUSIC_MAX_LENGTH_MS=120000

# AUDIO (Speech-to-Text)
# AUDIO_STT_ENGINE=elevenlabs
# AUDIO_STT_ELEVENLABS_API_KEY=
# AUDIO_STT_MODEL=scribe_v1
# ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io

# Voice credits (Redis required)
# REDIS_URL=redis://localhost:6379/0
# Docker Compose helper: docker compose -f docker-compose.yaml -f docker-compose.redis.yaml up -d
# Redis-only helper (local backend): docker compose -f docker-compose.redis-only.yaml up -d
# REDIS_KEY_PREFIX=owui
#
# Stripe Checkout (paid voice credits)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook endpoint URL (Stripe dashboard): https://<your-host>/api/v1/stripe/webhook
# Recommended events: checkout.session.completed, checkout.session.async_payment_succeeded
# STRIPE_PRICE_ID_STT_10000=price_...
# STRIPE_PRICE_ID_STT_100000=price_...
# STRIPE_PRICE_ID_STT_500000=price_...
# STRIPE_PRICE_ID_STT_1000000=price_...
# Optional:
# STRIPE_SUCCESS_URL=http://localhost:8080/?credits=success
# STRIPE_CANCEL_URL=http://localhost:8080/?credits=cancel
# STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
